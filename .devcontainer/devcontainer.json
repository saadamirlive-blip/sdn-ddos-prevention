{
  "name": "SDN DDoS Prevention Lab",
  "image": "ubuntu:22.04",

  // Mininet needs privileged mode + host networking capabilities
  "runArgs": [
    "--privileged",
    "--cap-add=ALL",
    "--net=host"
  ],
  "containerEnv": {
    "DEBIAN_FRONTEND": "noninteractive"
  },

  // Install everything on container creation
  "onCreateCommand": "bash .devcontainer/install.sh",

  // Activate venv in every new terminal
  "postStartCommand": "echo 'source /opt/sdn_venv/bin/activate' >> ~/.bashrc && source /opt/sdn_venv/bin/activate || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "njpwerner.autodocstring",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/sdn_venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "python.formatting.provider": "autopep8"
      }
    }
  },

  "forwardPorts": [6633, 6653, 8080],
  "portsAttributes": {
    "6633": { "label": "OpenFlow (legacy)", "onAutoForward": "silent" },
    "6653": { "label": "OpenFlow 1.3",     "onAutoForward": "silent" },
    "8080": { "label": "Ryu REST API",     "onAutoForward": "notify"  }
  },

  "remoteUser": "root"
}
